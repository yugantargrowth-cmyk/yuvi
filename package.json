{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "echo skip",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "pnpm --filter @workspace/mockup-sandbox run dev",
    "dev:ui": "pnpm --filter @workspace/mockup-sandbox run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "start:api": "pnpm --filter @workspace/api-server run start",
    "test": "pnpm --filter @workspace/scripts run test:sales",
    "test:sales": "pnpm --filter @workspace/scripts run test:sales"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.4",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
